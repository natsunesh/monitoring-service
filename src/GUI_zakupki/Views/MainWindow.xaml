<Window x:Class="GUI_zakupki.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GUI_zakupki.ViewModels"
        Title="Monitor Zakupki" Height="650" Width="900">

	

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
			<Button Content="Load" Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
			<Button Content="Save" Command="{Binding SaveCommand}"/>
		</StackPanel>

		<TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,0,0,12" FontWeight="SemiBold"/>

		<ScrollViewer Grid.Row="2">
			<StackPanel>
				<GroupBox Header="INN list" Margin="0,0,0,12">
					<StackPanel Margin="8">
						<DockPanel Margin="0,0,0,8">
							<TextBox Width="240"
                                     Text="{Binding NewInn, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"/>
							<Button Content="Add" Command="{Binding AddInnCommand}" Margin="0,0,8,0"/>
							<Button Content="Remove" Command="{Binding RemoveInnCommand}"/>
						</DockPanel>

						<ListBox ItemsSource="{Binding InnList}"
                                 SelectedItem="{Binding SelectedInn}"
                                 MinHeight="120"/>
					</StackPanel>
				</GroupBox>

				<GroupBox Header="Settings">
					<StackPanel Margin="8">
						<TextBlock Text="Interval hours"/>
						<TextBox Text="{Binding IntervalHours, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

						<CheckBox Content="Test mode"
                                  IsChecked="{Binding Test}"
                                  Margin="0,0,0,8"/>

						<TextBlock Text="Saved HTML path"/>
						<TextBox Text="{Binding FilePathToSavedHtml, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

						<TextBlock Text="Logs path"/>
						<TextBox Text="{Binding FilePathToLogs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

						<TextBlock Text="App config path"/>
						<TextBox Text="{Binding FilePathToAppConfig, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
					</StackPanel>
				</GroupBox>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>