{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZakupkiMonitorConfig",
  "description": "Схема конфигурации службы мониторинга закупок",
  "type": "object",
  "required": [ "version", "interval_hours", "selectors", "emails", "inn_list", "history" ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Версия схемы конфигурации",
      "example": "1.0"
    },
    "interval_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24,
      "default": 1,
      "description": "Интервал проверки в часах (от 1 до 24)"
    },
    "selectors": {
      "type": "object",
      "required": [ "css" ],
      "description": "Селекторы для парсинга HTML",
      "properties": {
        "css": {
          "type": "object",
          "description": "CSS-селекторы",
          "required": [ "purchase_card", "purchase_id", "purchase_name", "purchase_price", "publisher_inn", "purchase_link", "purchase_date" ],
          "properties": {
            "purchase_card": {
              "type": "string",
              "description": "Контейнер карточки закупки"
            },
            "purchase_id": {
              "type": "string",
              "description": "Номер закупки"
            },
            "purchase_name": {
              "type": "string",
              "description": "Название/описание закупки"
            },
            "purchase_price": {
              "type": "string",
              "description": "Цена закупки"
            },
            "publisher_inn": {
              "type": "string",
              "description": "ИНН заказчика"
            },
            "purchase_link": {
              "type": "string",
              "description": "Ссылка на закупку"
            },
            "purchase_date": {
              "type": "string",
              "description": "Дата публикации"
            }
          }
        },
        "xpath": {
          "type": "object",
          "description": "XPath-селекторы (опционально, если CSS недостаточно)",
          "additionalProperties": true
        }
      }
    },
    "emails": {
      "type": "array",
      "description": "Список email-адресов для уведомлений",
      "items": {
        "type": "string",
        "format": "email"
      },
      "minItems": 1,
      "example": [ "zakupki@example.com", "director@example.com" ]
    },
    "inn_list": {
      "type": "array",
      "description": "Список отслеживаемых ИНН (10 или 12 цифр)",
      "items": {
        "type": "string",
        "pattern": "^\\d{10}$|^\\d{12}$"
      },
      "minItems": 1,
      "example": [ "7728168971", "7736050003" ]
    },
    "history": {
      "type": "array",
      "description": "История уже обработанных закупок (реестровые номера). Не редактировать вручную!",
      "items": { "type": "string" },
      "default": [],
      "example": [ "0373100124520000016", "0373100124520000023" ]
    },
    "smtp": {
      "type": "object",
      "description": "Настройки SMTP для отправки уведомлений",
      "required": [ "host", "port", "from_email" ],
      "properties": {
        "host": {
          "type": "string",
          "description": "SMTP сервер",
          "example": "smtp.yandex.ru"
        },
        "port": {
          "type": "integer",
          "description": "Порт SMTP",
          "example": 465
        },
        "from_email": {
          "type": "string",
          "format": "email",
          "description": "Email отправителя",
          "example": "noreply@example.com"
        },
        "from_name": {
          "type": "string",
          "description": "Имя отправителя",
          "example": "Zakupki Monitor"
        },
        "use_ssl": {
          "type": "boolean",
          "default": true,
          "description": "Использовать SSL"
        },
        "login": {
          "type": "string",
          "description": "Логин для авторизации (опционально)"
        },
        "password": {
          "type": "string",
          "description": "Пароль для авторизации (опционально)"
        }
      }
    }
  }
}